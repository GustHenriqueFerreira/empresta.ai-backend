// Representação da versão proposta. Não substitui o schema original/cliente em uso.
// Índice parcial, checks e RLS estão no SQL; Prisma não representa essas regras.
datasource db {
  provider = "postgresql"
}

model Profile {
  id String @id @db.Uuid
  nome String
  papel String @default("colaborador")
  criado_em DateTime @default(now()) @db.Timestamptz
  emprestimos Emprestimo[]
  @@map("profiles")
}

model Equipamento {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome String
  categoria String
  patrimonio String @default("TI-—")
  situacao String @default("disponivel")
  observacoes String?
  criado_em DateTime @default(now()) @db.Timestamptz
  emprestimos Emprestimo[]
  imagem EquipamentoImagem?
  @@map("equipamentos")
}

model Emprestimo {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  equipamento_id String @db.Uuid
  usuario_id String @db.Uuid
  retirado_em DateTime @default(now()) @db.Timestamptz
  devolver_ate DateTime @db.Date
  devolvido_em DateTime? @db.Timestamptz
  equipamento Equipamento @relation(fields: [equipamento_id], references: [id])
  usuario Profile @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  @@map("emprestimos")
}

model EquipamentoImagem {
  equipamento_id String @id @db.Uuid
  equipamento Equipamento @relation(fields: [equipamento_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bucket String
  caminho String @unique
  largura Int
  altura Int
  sha256 String @unique
  fornecedor String
  foto_id BigInt @unique
  pagina_origem String
  autor String
  autor_id BigInt
  licenca_url String
  origem_arquivo String
  obtida_em DateTime @db.Timestamptz
  @@map("equipamentos_imagens")
}
